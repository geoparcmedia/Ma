[{"id":"2a6daa2","elType":"container","settings":{"content_width":"full","flex_direction":"column","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0","isLinked":true}},"elements":[{"id":"ac5b479","elType":"widget","settings":{"shortcode":"[elementor-template id=3639]"},"elements":[],"widgetType":"shortcode"},{"id":"a24741c","elType":"widget","settings":{"html":"<section class='et et-hero et-hero-s'><picture><source media='(max-width:700px)' srcset='https://epictravelmorocco.com/wp-content/uploads/2025/11/pexels-adthiry-18661913-600x810.jpg'><img src='https://epictravelmorocco.com/wp-content/uploads/2025/11/pexels-adthiry-18661913-1536x1024.jpg' alt='' fetchpriority='high' decoding='async' data-o='https://epictravelmorocco.com/wp-content/uploads/2025/11/pexels-adthiry-18661913-scaled.jpg' onerror=etF(this)></picture><span class='et-arch-o'></span><div class='et-wrap'><div class='et-crumb'><a href='https://epictravelmorocco.com/'>Home</a> / <a href='https://epictravelmorocco.com/destination/'>Tours</a> / Journey Through Morocco</div><span class='et-eye'>Cities & desert · 5 days</span><h1>Journey Through Morocco</h1><p class='lead'>A 5-day immersive journey through Morocco’s imperial cities, Atlas Mountains, and the Sahara Desert.</p><div class='et-ctas'><a class='et-btn' href='#et-iti'>See the day-by-day plan <svg aria-hidden='true' width='16' height='16'><use href='#et-i-arrow'/></svg></a><a class='et-btn et-btn-w et-btn-wa' href='https://wa.me/212661292596?text=Hello%20Epic%20Travel%20Morocco,%20I%20am%20interested%20in%20the%20Journey%20Through%20Morocco%20(5%20days).%20' target='_blank' rel='noopener'><svg aria-hidden='true'><use href='#et-i-wa'/></svg>Book on WhatsApp</a></div></div></section><div class='et'><div class='et-wrap'><div class='et-facts'><div><b>5 days</b><span>4 nights</span></div><div><b>Casablanca</b><span>starting point</span></div><div><b>Marrakech</b><span>end of the tour</span></div><div><b>Private</b><span>your own driver &amp; vehicle</span></div></div></div></div><section class='et et-sec' id='et-iti'><div class='et-wrap et-tour'><div><h3 style='font-size:20px'>Route</h3><div class='et-stops'><span>Casablanca</span><span>Rabat</span><span>Chefchaouen</span><span>Fes</span><span>Ifrane</span><span>Merzouga</span><span>Dades</span><span>Ouarzazate</span><span>Marrakech</span></div><div class='et-iti-h'><div><span class='et-eye'>Itinerary</span><h2>Day by day</h2></div><button type='button' class='et-tog' data-o='0'>Open all days</button></div><div class='et-iti'><details class='et-day et-rv' open><summary><span class='et-node'>1</span><small>Day 1</small><b>Casablanca arrival day</b></summary><div class='et-day-b'><p>Upon arrival at Casablanca airport, our team will greet you and transfer you to your hotel. Check in and unwind.</p></div></details><details class='et-day et-rv'><summary><span class='et-node'>2</span><small>Day 2</small><b>Casablanca · Rabat · Chefchaouen</b></summary><div class='et-day-b'><p>Visit Casablanca’s Hassan II Mosque and Mohammed V Square. Continue to Rabat to see the Mohammed V Mausoleum and Hassan Tower. Travel to Chefchaouen to explore its charming blue streets. Overnight stay in Chefchaouen.</p></div></details><details class='et-day et-rv'><summary><span class='et-node'>3</span><small>Day 3</small><b>Chefchaouen · Fes</b></summary><div class='et-day-b'><p>Journey to Fes with a guided tour: visit El Kairaouin Mosque & University, South Tower, Pottery Village, Nejjarine Square, the King’s Residence, Tanners, and Jewish Quarter. Leisure time in Fes for overnight stay.</p></div></details><details class='et-day et-rv'><summary><span class='et-node'>4</span><small>Day 4</small><b>Fes · Merzouga Desert</b></summary><div class='et-day-b'><p>Travel southeast through Ifrane (“Little Switzerland”), Azrou Cedar forests, and Midelt. Continue south through the Atlas Mountains to Errachidia and Erfoud. Enjoy a camel trek or 4x4 ride at sunset to your desert camp. Dine under the stars and experience local music. Overnight at your luxury desert tent.</p></div></details><details class='et-day et-rv'><summary><span class='et-node'>5</span><small>Day 5</small><b>Merzouga · Marrakech</b></summary><div class='et-day-b'><p>Sunrise over the desert sands. Breakfast, then travel to Marrakech via Tinghir, Boumalen Dades, Skoura, Ouarzazate, and Tichka Pass. Drop-off at your accommodation in Marrakech. End of Journey Through Morocco Tour.</p></div></details></div><div class='et-note'><svg aria-hidden='true'><use href='#et-i-info'/></svg><div><b>Tailor-made:</b> The tour is fully customizable to your preferences and duration. Tell us your dates and we send you a detailed quote.</div></div></div><aside class='et-side'><div class='et-book'><div class='et-book-h et-dark'><h3>Book this tour</h3><p>Free quote within 24 hours — no payment to ask.</p></div><ul><li><span>Duration</span><b>5 days / 4 nights</b></li><li><span>Start</span><b>Casablanca</b></li><li><span>End</span><b>Marrakech</b></li><li><span>Style</span><b>Cities & desert</b></li><li><span>Type</span><b>Private tour</b></li></ul><div class='et-book-f'><a class='et-btn et-btn-wa' href='https://wa.me/212661292596?text=Hello%20Epic%20Travel%20Morocco,%20I%20am%20interested%20in%20the%20Journey%20Through%20Morocco%20(5%20days).%20' target='_blank' rel='noopener'><svg aria-hidden='true'><use href='#et-i-wa'/></svg>Book on WhatsApp</a><a class='et-btn et-btn-o' href='mailto:epictravelmorocco@gmail.com?subject=Journey%20Through%20Morocco'><svg aria-hidden='true'><use href='#et-i-mail'/></svg>Email us</a><a class='et-btn' href='https://epictravelmorocco.com/contact-2/'>Send a request</a><small>WhatsApp +212 661 292 596 · Tel +1 579 484 7707</small></div></div></aside></div></section><section class='et et-sec et-pat'><div class='et-wrap'><div