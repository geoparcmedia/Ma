obals__":{"button_color_hover":"","button_bg_color":""}},"elements":[],"widgetType":"travolocta"}],"isInner":false},{"id":"b3e81d4","elType":"container","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0","isLinked":true}},"elements":[{"id":"b3e81d4w","elType":"widget","settings":{"html":"<section class='amx amx-band'><div class='amx-zz'></div><div class='amx-wrap'><div class='amx-head'><span class='amx-hand'>Simple as that</span><h2>How a trip with us works</h2><p>No booking engine maze. You talk to us, we sort it out.</p></div><div class='amx-steps'><div class='amx-step'><h3>Tell us your plan</h3><p>Dates, how many of you, and roughly what you'd like to see. A rough idea is fine.</p></div><div class='amx-step'><h3>We shape it together</h3><p>We send a day-by-day plan and a price. Change whatever you like until it feels right.</p></div><div class='amx-step'><h3>We pick you up</h3><p>From the airport, your riad or hotel. After that, just enjoy the ride.</p></div></div></div></section><section class='amx' style='padding:110px 0 40px;background:#fff'><div class='amx-wrap'><div class='amx-head'><span class='amx-hand'>Our guests</span><h2>A few faces from recent trips</h2><p>Families, friends, solo travellers and groups. Every trip ends with a photo, and we'll keep adding them here.</p></div><div class='amx-wall'><figure class='amx-pol amx-a'><img src='https://amasirvoyage.com/wp-content/uploads/2026/10/amasir-guests-marrakech-airport.jpg' width='1600' height='1200' alt='Amasir Voyage guide with four smiling travellers at Marrakech Menara airport' loading='lazy' decoding='async'><figcaption>First hello at Marrakech airport</figcaption></figure><figure class='amx-pol amx-b'><img src='https://amasirvoyage.com/wp-content/uploads/2026/10/sunset-jump-sahara-dunes.jpg' width='1200' height='1600' alt='Amasir Voyage guide jumping on top of a sand dune at 