[{"id":"am0abou","elType":"container","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_gap":{"unit":"px","size":0,"column":"0","row":"0","isLinked":true}},"elements":[{"id":"ama00w","elType":"widget","settings":{"html":"<section class='am am-hero am-hero--sm'><div class='am-hero-bg'><img src='https://amasirvoyage.com/wp-content/uploads/2026/08/WhatsApp-Image-2026-08-06-at-11.25.06-AM2-1.jpeg' alt='Amasir Voyage guide with travellers in Morocco' fetchpriority='high' decoding='async'></div><div class='am-w'><span class='am-eb'>About us</span><h1>A small Marrakech team, <em>not a call centre</em></h1><p class='am-hero-lead'>Drivers and guides who live here, planning private trips we'd be happy to take our own families on.</p></div></section>"},"elements":[],"widgetType":"html"},{"id":"ama01w","elType":"widget","settings":{"html":"<section class='am am-sec am-sec--white'><div class='am-w am-split'><div class='am-tx'><span class='am-eb'>Our story, in short</span><h2>Trips built around <em>people</em>, not packages</h2><p>Amasir Voyage is a small team based in Marrakech. We run private day trips, multi-day tours and airport transfers across Morocco.</p><p>Our regular day trips go to Agafay, the Ourika Valley, Imlil, Essaouira and the Ouzoud waterfalls. For longer trips we head over the Atlas to Merzouga and the Sahara, or north to Chefchaouen and Fes. If you have your own idea, we're happy to build the trip around it.</p><p>We keep every trip private, plan realistic driving days, and leave a bit of room in the schedule for the things you only discover once you're here.</p><span class='am-sign'>Marhaba, and see you soon</span></div><div class='am-arch' style='margin-left:auto'><img src='https://amasirvoyage.com/wp-content/uploads/2026/10/family-trip-mountain-viewpoint-morocco.jpg' alt='Family of four with their Amasir Voyage guide at a mountain viewpoint' width='1200' height='1600' loading='lazy' decoding='async'><div class='am-stamp' aria-hidden='true'><svg viewBox='0 0 136 136'><defs><path id='amc' d='M68 68m-50 0a50 50 0 1 1 100 0a50 50 0 1 1-100 0'/></defs><text font-family='Inter,sans-serif' font-size='11.5' font-weight='600' letter-spacing='3.2' fill='#221C17'><textPath href='#amc'>PRIVATE TOURS &#183; MARRAKECH &#183; MOROCCO &#183; </textPath></text></svg><b>&#10022;</b></div></div></div></section>"},"elements":[],"widgetType":"html"},{"id":"ama02w","elType":"widget","settings":{"html":"<section class='am am-sec am-sec--sand'><div class='am-w'><div class='am-sh'><div><span class='am-eb'>Why travellers book with us</span><h2>The small things that make a <em>good trip</em></h2></div><p>Nothing fancy. Just the way we think a trip in Morocco should be run.</p></div><div class='am-vals'><div class='am-val'><i><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><circle cx='9' cy='8' r='3.5'/><path d='M2.5 20a6.5 6.5 0 0 1 13 0'/><path d='M16 4.5a3.5 3.5 0 0 1 0 7M18.5 20a6.5 6.5 0 0 0-3-5.5'/></svg></i><h3>Private, always</h3><p>It's just you and the people you came with. No strangers, no fixed group schedule.</p></div><div class='am-val'><i><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z'/><path d='M9 4v14M15 6v14'/></svg></i><h3>Routes we know well</h3><p>Honest driving times, good stops and the right place for lunch.</p></div><div class='am-val'><i><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 17h14M3 13l2-5.5A2 2 0 0 1 6.9 6h10.2a2 2 0 0 1 1.9 1.5L21 13v4h-2'/><path d='M5 17H3v-4h18'/><circle cx='7.5' cy='17' r='1.8'/><circle cx='16.5' cy='17' r='1.8'/></svg></i><h3>Careful drivers</h3><p>Comfortable cars and drivers who know the mountain roads.</p></div><div class='am-val'><i><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M21 12a8 8 0 0 1-11.6 7.2L4 21l1.8-5.4A8 8 0 1 1 21 12z'/></svg></i><h3>A real person to talk to</h3><p>Message us before the trip and during it. Plans change, and that is fine.</p></div></div></div></section>"},"elements":[],"widgetType":"html"},{"id":"ama03w","elType":"widget","settings":{"html":"<section class='am am-sec'><div class='am-w'><div class='am-sh am-sh--c'><span class='am-hand'>Our guests</span><h2>A few faces from <em>recent trips</em></h2><p>Families, friends, solo travellers and groups. Every trip ends with a photo, and we'll keep adding them here.</p></div><div class='am-wall'><figure class='am-pol am-pa'><img src='https://amasirvoyage.com/wp-content/uploads/2026/10/amasir-guests-marrakech-airport.jpg' alt='Amasir Voyage guide with four smiling travellers at Marrakech Menara airport' width='1600' height='1200' loading='lazy' decoding='async'><figcaption>First hello at Marrakech airport</figcaption></figure><figure class='am-pol am-pb'><img src='https://amasirvoyage.com/wp-content/uploads/2026/10/sunset-jump-sahara-dunes.jpg' alt='Amasir Voyage guide jumping on top of a sand dune at sunset' width='1200' height='1600' loading='lazy' decoding='async'><figcaption>Someone always jumps at sunset</figcaption></figure><figure class='am-pol am-pc'><img src='https://amasirvoyage.com/wp-content/uploads/2026/10/group-day-trip-morocco.jpg' alt='Group of young travellers smiling with their guide on a day trip' width='590' height='787' loading='lazy' decoding='async'><figcaption>Group day trip, all smiles</figcaption></figure><figure class='am-pol am-pf'><img src='https://amasirvoyage.com/wp-content/uploads/2026/10/family-group-marrakech-airport-departure.jpg' alt='Two families with their Amasir Voyage guide at Marrakech airport' width='1600' height='738' loading='lazy' decoding='async'><figcaption>The hardest part: goodbye at the airport</figcaption></figure></div></div></section>"},"elements":[],"widgetType":"html"},{"id":"ama04w","elType":"widget","settings":{"html":"<section class='am am-sec am-sec--white'><div class='am-w'><div class='am-sh'><div><span class='am-eb'>How it works</span><h2>Booking is a <em>conversation</em>, not a form</h2></div><p>No booking engine maze and no surprises on the day. You talk to us, we sort the rest.</p></div><div class='am-steps'><div class='am-step'><b>01</b><h3>Tell us your plan</h3><p>Dates, how many of you, and roughly what you'd like to see. A rough idea is plenty.</p></div><div class='am-step'><b>02</b><h3>We shape it together</h3><p>We send a day-by-day plan and a price. Change anything until it feels right.</p></div><div class='am-step'><b>03</b><h3>We pick you up</h3><p>At the airport, your riad or your hotel. From there, just enjoy the road.</p></div></div></div></section>"},"elements":[],"widgetType":"html"},{"id":"ama05w","elType":"widget","settings":{"html":"<section class='am am-sec am-sec--white' style='padding-top:40px'><div class='am-w'><div class='am-cta'><div><span class='am-hand'>Yalla, let's plan it</span><h2>Have a trip <em>in mind?</em></h2></div><div class='am-btns'><a class='am-btn am-btn--white' href='https://wa.me/212660751249?text=Hello%20Amasir%20Voyage%2C%20I%27d%20like%20to%20plan%20a%20trip' target='_blank' rel='noopener'><svg viewBox='0 0 24 24' fill='currentColor' aria-hidden='true'><path d='M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.8 2.3 1 2.5c.1.2 1.6 2.5 4 3.5 1.5.6 2 .7 2.8.6.4-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.4-.2z'/></svg> WhatsApp us</a><a class='am-btn am-btn--ghost' href='https://amasirvoyage.com/contact/'>Send a message</a></div></div></div></section>"},"elements":[],"widgetType":"html"}],"isInner":false}]