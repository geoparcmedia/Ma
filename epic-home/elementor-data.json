[{"id":"190f522","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_gap":{"unit":"px","size":0,"column":"0","row":"0"},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"5dfbfca","elType":"widget","settings":{"html":"<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin><link rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Marcellus&family=Jost:wght@400;500;600&display=swap'><style>.etm{--teal:#5c828f;--teal2:#3f6572;--sand:#d1a47b;--sand2:#b98a5e;--ink:#05181f;--cream:#fff9f0;--mut:#5e6b70; --fh:'Marcellus',Georgia,serif;--fb:'Jost',system-ui,-apple-system,'Segoe UI',sans-serif; font-family:var(--fb);color:var(--ink);font-size:17px;line-height:1.7;overflow-x:clip} .etm *,.etm *:before,.etm *:after{box-sizing:border-box} .etm h1,.etm h2,.etm h3{font-family:var(--fh);font-weight:400;letter-spacing:.01em;line-height:1.15;margin:0;color:inherit;text-transform:none} .etm p{margin:0 0 1em} .etm a{text-decoration:none} .etm img{max-width:100%;display:block} .etm-i{width:22px;height:22px;flex:none;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round} .etm-wrap{max-width:1240px;margin:0 auto;padding:0 24px} .etm-eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:13px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:var(--sand2);margin-bottom:14px} .etm-eyebrow:before,.etm-eyebrow:after{content:'';width:18px;height:18px;background:currentColor;clip-path:polygon(50% 0,61% 29%,93% 22%,71% 50%,93% 78%,61% 71%,50% 100%,39% 71%,7% 78%,29% 50%,7% 22%,39% 29%)} .etm-head{text-align:center;max-width:720px;margin:0 auto 48px} .etm-head h2{font-size:clamp(32px,4.4vw,50px)} .etm-head p{color:var(--mut);margin-top:14px} .etm-btn{display:inline-flex;align-items:center;gap:10px;padding:15px 28px;border-radius:999px;background:var(--sand);color:var(--ink)!important;font:600 15.5px/1 var(--fb);letter-spacing:.04em;transition:transform .2s,background .2s} .etm-btn:hover{background:#e0b88f;transform:translateY(-2px)} .etm-btn .etm-i{width:18px;height:18px} .etm-btn-line{background:transparent;color:#fff!important;box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.6)} .etm-btn-line:hover{background:rgba(255,255,255,.1)} .etm-btn-dark{background:var(--ink);color:#fff!important} .etm-btn-dark:hover{background:var(--teal2)} /* zellij borders */ .etm-band{height:28px;background:var(--zb);background-size:28px 28px} .etm-band-thin{height:14px;background:var(--zb);background-size:14px 14px;opacity:.9} /* hero */ .etm-hero{position:relative;min-height:min(92vh,820px);display:flex;align-items:center;color:#fff;overflow:hidden;background:var(--ink)} .etm-hero-bg{position:absolute;inset:0} .etm-hero-bg img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transform:scale(1.06);transition:opacity 1.6s ease,transform 9s linear} .etm-hero-bg img.on{opacity:1;transform:scale(1)} .etm-hero:before{content:'';position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(5,24,31,.86) 0%,rgba(5,24,31,.55) 45%,rgba(5,24,31,.15) 100%)} .etm-hero:after{content:'';position:absolute;z-index:1;top:0;bottom:0;right:0;width:34%;background:var(--zd);background-size:120px 120px;-webkit-mask:linear-gradient(90deg,transparent,#000 70%);mask:linear-gradient(90deg,transparent,#000 70%);opacity:.7} .etm-hero-in{position:relative;z-index:2;padding:150px 24px 110px;width:100%} .etm-hero .etm-eyebrow{color:var(--sand)} .etm-hero h1{font-size:clamp(42px,6.6vw,84px);max-width:13ch;color:#fff} .etm-hero h1 em{font-style:normal;color:var(--sand)} .etm-hero p.etm-lead{max-width:560px;font-size:clamp(17px,1.6vw,20px);color:rgba(255,255,255,.85);margin:22px 0 32px} .etm-cta{display:flex;flex-wrap:wrap;gap:12px} .etm-trust{display:flex;flex-wrap:wrap;gap:10px 26px;margin-top:40px;font-size:14.5px;color:rgba(255,255,255,.85)} .etm-trust span{display:inline-flex;align-items:center;gap:8px} .etm-trust .etm-i{width:18px;height:18px;color:var(--sand)} /* marquee */ .etm-marq{background:var(--teal);color:#fff;overflow:hidden;padding:18px 0} .etm-marq-t{display:flex;width:max-content;animation:etmscroll 34s linear infinite} .etm-marq-t span{display:inline-flex;align-items:center;gap:26px;padding-right:26px;font:400 clamp(18px,2.4vw,28px)/1 var(--fh);letter-spacing:.14em;text-transform:uppercase;white-space:nowrap} .etm-marq-t i{width:16px;height:16px;background:var(--sand);clip-path:polygon(50% 0,61% 29%,93% 22%,71% 50%,93% 78%,61% 71%,50% 100%,39% 71%,7% 78%,29% 50%,7% 22%,39% 29%)} @keyframes etmscroll{to{transform:translateX(-50%)}} /* sections */ .etm-sec{padding:clamp(70px,9vw,120px) 0;position:relative} .etm-cream{background-color:var(--cream);background-image:var(--zc);background-size:96px 96px} .etm-cream-plain{background:var(--cream)} .etm-white{background:#fff} /* welcome */ .etm-welcome{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:clamp(34px,6vw,80px);align-items:center} .etm-arch{position:relative;padding:14px;background:#fff;border-radius:999px 999px 18px 18px;box-shadow:0 30px 60px rgba(5,24,31,.12)} .etm-arch img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:999px 999px 10px 10px} .etm-arch:after{content:'';position:absolute;right:-26px;bottom:-26px;width:120px;height:120px;background:var(--zb);background-size:30px 30px;border-radius:14px;z-index:-1} .etm-welcome h2{font-size:clamp(32px,4.2vw,48px);margin-bottom:10px} .etm-welcome h3{font:500 20px/1.4 var(--fb);color:var(--teal);margin-bottom:18px} .etm-welcome p{color:var(--mut)} .etm-points{list-style:none;margin:22px 0 30px;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px 18px} .etm-points li{display:flex;gap:10px;align-items:center;font-weight:500} .etm-points li:before{content:'';width:14px;height:14px;flex:none;background:var(--sand);clip-path:polygon(50% 0,61% 29%,93% 22%,71% 50%,93% 78%,61% 71%,50% 100%,39% 71%,7% 78%,29% 50%,7% 22%,39% 29%)} /* tours */ .etm-tours{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px} .etm-tour{display:flex;flex-direction:column;background:#fff;border-radius:22px;overflow:hidden;box-shadow:0 14px 40px rgba(5,24,31,.08);transition:transform .3s,box-shadow .3s;color:var(--ink)!important} .etm-tour:hover{transform:translateY(-6px);box-shadow:0 24px 50px rgba(5,24,31,.14)} .etm-tour-img{position:relative;aspect-ratio:4/3;overflow:hidden;border-radius:0 0 50% 50%/0 0 14% 14%} .etm-tour-img img{width:100%;height:100%;object-fit:cover;transition:transform .7s} .etm-tour:hover .etm-tour-img img{transform:scale(1.07)} .etm-days{position:absolute;top:16px;left:16px;display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:999px;background:rgba(255,249,240,.94);font-size:13.5px;font-weight:600} .etm-days .etm-i{width:16px;height:16px;color:var(--teal)} .etm-tour-b{padding:22px 24px 26px;display:flex;flex-direction:column;flex:1} .etm-tour-b small{color:var(--sand2);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12.5px} .etm-tour h3{font-size:25px;margin:6px 0 16px} .etm-tour-go{margin-top:auto;display:inline-flex;align-items:center;gap:8px;font-weight:600;color:var(--teal)} .etm-tour-go .etm-i{width:18px;height:18px;transition:transform .2s} .etm-tour:hover .etm-tour-go .etm-i{transform:translateX(4px)} .etm-center{text-align:center;margin-top:46px} /* why */ .etm-why{background-color:var(--teal);background-image:var(--zt);background-size:110px 110px;color:#fff} .etm-why .etm-eyebrow{color:var(--sand)} .etm-why .etm-head p{color:rgba(255,255,255,.8)} .etm-why-g{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px} .etm-why-c{position:relative;padding:34px 26px 30px;background:rgba(5,24,31,.38);border:1px solid rgba(255,255,255,.14);border-radius:120px 120px 20px 20px;text-align:center;backdrop-filter:blur(3px)} .etm-why-c .etm-ic{display:grid;place-items:center;width:74px;height:74px;margin:0 auto 20px;background:var(--sand);color:var(--ink);clip-path:polygon(50% 0,63% 20%,85% 15%,80% 37%,100% 50%,80% 63%,85% 85%,63% 80%,50% 100%,37% 80%,15% 85%,20% 63%,0 50%,20% 37%,15% 15%,37% 20%)} .etm-why-c .etm-i{width:28px;height:28px} .etm-why-c h3{font-size:23px;margin-bottom:10px} .etm-why-c p{margin:0;font-size:15.5px;color:rgba(255,255,255,.82)} /* gallery */ .etm-gal{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:210px;gap:14px} .etm-gal figure{margin:0;overflow:hidden;border-radius:16px} .etm-gal figure:nth-child(1){grid-column:span 2;grid-row:span 2;border-radius:999px 999px 16px 16px} .etm-gal img{width:100%;height:100%;object-fit:cover;transition:transform .6s} .etm-gal figure:hover img{transform:scale(1.06)} /* reviews head */ .etm-rev{padding:clamp(60px,8vw,100px) 0 10px} /* contact */ .etm-contact{background-color:var(--ink);background-image:var(--zd);background-size:120px 120px;color:#fff} .etm-contact-in{display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:center} .etm-contact h2{font-size:clamp(32px,4.4vw,52px)} .etm-contact .etm-eyebrow{color:var(--sand)} .etm-contact p{color:rgba(255,255,255,.78);max-width:480px;margin-top:14px} .etm-cards{display:grid;gap:12px} .etm-card{display:flex;align-items:center;gap:16px;padding:18px 22px;border-radius:16px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:#fff!important;transition:background .2s,border-color .2s} a.etm-card:hover{background:rgba(209,164,123,.14);border-color:var(--sand)} .etm-card .etm-i{width:26px;height:26px;color:var(--sand)} .etm-card small{display:block;font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.6)} .etm-card b{font-weight:600;font-size:17px} /* reveal */ .etm-js .etm-rv{opacity:0;transform:translateY(26px);transition:opacity .9s ease,transform .9s ease} .etm-js .etm-rv.in{opacity:1;transform:none} @media (max-width:1024px){.etm-why-g{grid-template-columns:repeat(2,minmax(0,1fr))}.etm-tours{grid-template-columns:repeat(2,minmax(0,1fr))}} @media (max-width:860px){.etm-welcome,.etm-contact-in{grid-template-columns:1fr}.etm-arch{max-width:420px;margin:0 auto 20px} .etm-gal{grid-template-columns:repeat(2,1fr);grid-auto-rows:170px}.etm-gal figure:nth-child(n+8){display:none} .etm-hero:after{display:none}} @media (max-width:600px){.etm{font-size:16px}.etm-wrap{padding:0 18px}.etm-tours,.etm-why-g,.etm-points{grid-template-columns:1fr} .etm-hero-in{padding:120px 18px 80px}.etm-cta .etm-btn{flex:1 1 100%;justify-content:center} .etm-hero:before{background:linear-gradient(180deg,rgba(5,24,31,.55),rgba(5,24,31,.85))} .etm-arch:after{right:-10px;bottom:-12px;width:80px;height:80px}} @media (prefers-reduced-motion:reduce){.etm *{animation:none!important;transition:none!important}.etm-js .etm-rv{opacity:1;transform:none}}</style><script>(function(){var q=String.fromCharCode(34),P=Math.PI;function st(cx,cy,r1,r2,rot){var a=[];for(var i=0;i<16;i++){var r=i%2?r2:r1,t=P*i/8+rot;a.push((cx+r*Math.sin(t)).toFixed(1)+','+(cy-r*Math.cos(t)).toFixed(1))}return a.join(' ')}function at(k,v){return ' '+k+'='+q+v+q}function z(fg,fg2,bg,sw,s,fill){var c=s/2,o='';if(bg)o+='<rect'+at('width',s)+at('height',s)+at('fill',bg)+'/>';function pg(pts,col){return '<polygon'+at('points',pts)+(fill?at('fill',col):at('fill','none')+at('stroke',col)+at('stroke-width',sw))+'/>'}o+=pg(st(c,c,s*.40,s*.30,P/8),fg)+pg(st(c,c,s*.20,s*.15,P/8),fg2);[[0,0],[s,0],[0,s],[s,s]].forEach(function(p){o+=pg(st(p[0],p[1],s*.22,s*.12,0),fg2)});o+='<path'+at('d','M0 '+c+'H'+s+'M'+c+' 0V'+s)+at('stroke',fg)+at('stroke-width',sw*.7)+at('opacity','.35')+'/>';var svg='<svg'+at('xmlns','http://www.w3.org/2000/svg')+at('width',s)+at('height',s)+at('viewBox','0 0 '+s+' '+s)+'>'+o+'</svg>';return 'url('+q+'data:image/svg+xml,'+encodeURIComponent(svg)+q+')'}var r=document.documentElement.style;r.setProperty('--zb',z('#5c828f','#d1a47b','#05181f',1,56,1));r.setProperty('--zc',z('rgba(209,164,123,.38)','rgba(92,130,143,.24)',0,1.2,96,0));r.setProperty('--zt',z('rgba(255,255,255,.16)','rgba(209,164,123,.35)',0,1.3,96,0));r.setProperty('--zd',z('rgba(209,164,123,.22)','rgba(92,130,143,.35)',0,1.2,96,0));})();</script><div class='etm'><section class='etm-hero'><div class='etm-hero-bg'><img src='https://epictravelmorocco.com/wp-content/uploads/2025/08/pexels-ed-duvico-530456-29107895-scaled.jpg' alt='' class='on' fetchpriority='high'><img src='https://epictravelmorocco.com/wp-content/uploads/2025/11/pexels-mographe-3581916-scaled.jpg' alt='' loading='lazy'></div><div class='etm-wrap etm-hero-in'><span class='etm-eyebrow'>Epic Travel Morocco</span><h1>Where every journey becomes an <em>epic story</em></h1><p class='etm-lead'>Private tours across Morocco with local guides, from the souks of Marrakech to the golden dunes of the Sahara and the peaks of the Atlas.</p><div class='etm-cta'><a class='etm-btn' href='https://epictravelmorocco.com/destination/'>Explore our tours <svg class='etm-i' viewBox='0 0 24 24' aria-hidden='true'><path d='M5 12h14M13 6l6 6-6 6'/></svg></a><a class='etm-btn etm-btn-line' href='https://epictravelmorocco.com/contact-2/'>Plan my trip</a></div><div class='etm-trust'><span><svg class='etm-i' viewBox='0 0 24 24' aria-hidden='true'><path d='M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z'/><circle cx='12' cy='9.5' r='2.5'/></svg>Local guides</span><span><svg class='etm-i' viewBox='0 0 24 24' aria-hidden='true'><circle cx='6' cy='18' r='2.5'/><circle cx='18' cy='6' r='2.5'/><path d='M8.5 18H15a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h6.5'/></svg>Tailor-made itineraries</span><span><svg class='etm-i' viewBox='0 0 24 24' aria-hidden='true'><path d='M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z'/><path d='M8.5 12l2.5 2.5 4.5-4.5'/></svg>24/7 support</span></div></div></section><div class='etm-band'></div><div class='etm-marq' aria-hidden='true'><div class='etm-marq-t'><span>Plan smarter<i></i>Travel better<i></i>Epic Travel Morocco<i></i></span><span>Plan smarter<i></i>Travel better<i></i>Epic Travel Morocco<i></i></span><span>Plan smarter<i></i>Travel better<i></i>Epic Travel Morocco<i></i></span><span>Plan smarter<i></i>Travel better<i></i>Epic Travel Morocco<i></i></span></div></div><section class='etm-sec etm-cream'><div class='etm-wrap etm-welcome'><div class='etm-arch'><img src='https://epictravelmorocco.com/wp-content/uploads/2025/11/pexels-taryn-elliott-3889826-scaled.jpg' alt='Travelling in Morocco with Epic Travel Morocco' loading='lazy'></div><div><span class='etm-eyebrow'>Welcome</span><h2>Welcome to Epic Travel Morocco</h2><h3>Your gateway to the magic, history and vibrant culture of Morocco.</h3><p>Experience Morocco like never before with Epic Travel Morocco, your trusted local travel expert. From the golden dunes of the Sahara Desert to the vibrant souks of Marrakech and the majestic peaks of the Atlas Mountains, we craft journeys that go beyond the ordinary.</p><ul class='etm-points'><li>Imperial cities</li><li>Sahara nights</li><li>Atlas Mountains</li><li>Private driver</li></ul><a class='etm-btn etm-btn-dark' href='https://epictravelmorocco.com/about-us/'>About us <svg class='etm-i' viewBox='0 0 24 24' aria-hidden='true'><path d='M5 12h14M13 6l6 6-6 6'/></svg></a></div></div></section><section class='etm-sec etm-white'><div class='etm-wrap'><div class='etm-head'><span class='etm-eyebrow'>Popular tours</span><h2>Journeys our travelers love</h2><p>Hand-picked routes through Morocco’s imperial cities, mountains and Sahara, planned and guided by our local team. Every tour can be adapted to your dates and pace.</p></div><div class='etm-tours'><a class='etm-tour' href='https://epictravelmorocco.com/all-tour/sahara-desert-experience/'><div class='etm-tour-img'><img src='https://epictravelmorocco.com/wp-content/uploads/2025/11/pexels-zakariahanif-12214734-scaled.jpg' alt='Sahara Desert Experience' loading='lazy'><span class='etm-days'><svg class='etm-i' viewBox='0 0 24 24' aria-hidden='true'><circle cx='12'