70.2' y2='172.1'/><line x1='84.4' y1='115.6' x2='44.8' y2='155.2'/><line x1='79.7' y1='108.4' x2='27.9' y2='129.8'/><line x1='78.0' y1='100.0' x2='22.0' y2='100.0'/><line x1='79.7' y1='91.6' x2='27.9' y2='70.2'/><line x1='84.4' y1='84.4' x2='44.8' y2='44.8'/><line x1='91.6' y1='79.7' x2='70.2' y2='27.9'/></svg><div class='ch-w ch-hero-g'><div class='ch-hero-t'><span class='ch-k ch-k-l'><svg class='ch-star' viewBox='0 0 24 24' aria-hidden='true'><polygon points='12.0,1.5 14.4,6.3 19.4,4.6 17.7,9.6 22.5,12.0 17.7,14.4 19.4,19.4 14.4,17.7 12.0,22.5 9.6,17.7 4.6,19.4 6.3,14.4 1.5,12.0 6.3,9.6 4.6,4.6 9.6,6.3'/><circle cx='12' cy='12' r='2.2'/></svg>Our fleet</span><h1>Car rental<br><em>with driver</em></h1><p>Tailored travel transport across Morocco. Experience the country in comfort and luxury, with professional drivers and a fleet for every journey.</p><div class='ch-hero-act'><a class='ch-btn ch-btn-g' href='https://epictravelmorocco.com/contact-2/'>Book a vehicle</a><a href='https://wa.me/212661292596'>WhatsApp</a></div></div><div class='ch-archf'><div class='ch-arch'><img src='https://epictravelmorocco.com/wp-content/uploads/2025/11/Gemini_Generated_Image_vvja03vvja03vvja.png' alt='Epic Travel Morocco vehicle'></div></div></div></section><section class='ch-s' style='padding-bottom:60px'><div class='ch-w'><div class='cp-intro'><div class='ch-orn '><span></span><svg class='ch-star' viewBox='0 0 24 24' aria-hidden='true'><polygon points='12.0,1.5 14.4,6.3 19.4,4.6 17.7,9.6 22.5,12.0 17.7,14.4 19.4,19.4 14.4,17.7 12.0,22.5 9.6,17.7 4.6,19.4 6.3,14.4 1.5,12.0 6.3,9.6 4.6,4.6 9.6,6.3'/><circle cx='12' cy='12' r='2.2'/></svg><span></span></div><p class='ch-lead'>From the elegant Mercedes Vito to the rugged Toyota Prado, from Sprinter minibuses to spacious coaches, each vehicle is meticulously maintained for a smooth and enjoyable ride.</p></div><div class='cp-feat'><div><svg class='ch-star' viewBox='0 0 24 24' aria-hidden='true'><polygon points='12.0,1.5 14.4,6.3 19.4,4.6